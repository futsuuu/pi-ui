{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["@earendil-works/*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["playwright"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["every weekend"],
    "groupName": "lockfiles"
  }
}
